# Get your BOT_TOKEN from Telegram @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram user ID (or multiple IDs separated by commas)
# You can find your ID by messaging @userinfobot or @raw_data_bot on Telegram
ADMIN_IDS=123456789

# Support contact handle or channel shown to users
SUPPORT_HANDLE=@YourSupportAdmin

# Path to the SQLite database
DB_PATH=bot_database.sqlite
